# Pinned inputs for the fresco-legacy build (packaging/legacy/build.sh).
# Every tarball is checked against its sha256 before it is unpacked. Bump a
# version here and the CI cache key (hashFiles of this file) changes with it.
#
# Why each one is built from source: Debian buster (Deepin V20 / UOS 20 base)
# ships glib 2.58, pango 1.42, harfbuzz 2.3, fribidi 1.0.5 and graphene 1.8,
# and has no GTK 4 or libadwaita at all. GTK 4.6 needs glib >= 2.66, pango
# >= 1.50, harfbuzz >= 2.6, fribidi >= 1.0.6 and graphene >= 1.9.1, so those
# five go into /opt/fresco-legacy. Everything else (cairo, gdk-pixbuf, epoxy,
# xkbcommon, fontconfig, freetype, libmpv) is buster's own and already new
# enough.

GLIB_VERSION=2.68.4
GLIB_URL=https://download.gnome.org/sources/glib/2.68/glib-2.68.4.tar.xz
GLIB_SHA256=62fd061d08a75492617e625a73e2c05e259f831acbb8e1f8b9c81f23f7993a3b

GRAPHENE_VERSION=1.10.8
GRAPHENE_URL=https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz
GRAPHENE_SHA256=a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a

FRIBIDI_VERSION=1.0.12
FRIBIDI_URL=https://github.com/fribidi/fribidi/releases/download/v1.0.12/fribidi-1.0.12.tar.xz
FRIBIDI_SHA256=0cd233f97fc8c67bb3ac27ce8440def5d3ffacf516765b91c2cc654498293495

HARFBUZZ_VERSION=2.9.1
HARFBUZZ_URL=https://github.com/harfbuzz/harfbuzz/releases/download/2.9.1/harfbuzz-2.9.1.tar.xz
HARFBUZZ_SHA256=0edcc980f526a338452180e701d6aba6323aef457b6686976a7d17ccbddc51cf

PANGO_VERSION=1.50.14
