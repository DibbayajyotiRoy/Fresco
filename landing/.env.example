# Public canonical URL of the deployed site. Used for metadata (Open Graph,
# canonical links). Set this in your host's environment variables.
SITE_URL=https://fresco.dibbayajyoti.com

# Supabase project that receives Fresco's opt-in telemetry. The stats band
# reads live aggregate counts (users, countries, active in the last 24h) from
# the public_stats() RPC in supabase/schema.sql, revalidated hourly. Use the
# publishable/anon key the desktop app already ships, NEVER the service-role
# key. Leave both unset and the site shows the hand-maintained floors instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
