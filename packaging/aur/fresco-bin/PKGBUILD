# Maintainer: Dibbayajyoti Roy <maromaromuje28@gmail.com>
# Fresco — live wallpapers for Linux (binary repackage of the release .deb).
#
# The .deb bundles mpvpaper under /usr/lib/fresco (Debian doesn't package it);
# on Arch we keep that bundled copy so the binary package works stand-alone.

pkgname=fresco-bin
_pkgname=fresco
pkgver=1.0.0
pkgrel=1
pkgdesc="Live wallpapers for Linux — video, GIF, image, slideshow and playlist wallpapers (binary release)"
arch=('x86_64')
url="https://github.com/DibbayajyotiRoy/fresco"
license=('GPL-3.0-or-later')
provides=('fresco')
conflicts=('fresco')
# glib2 owns /usr/bin/gdbus and /usr/bin/gsettings — see the fresco PKGBUILD.
depends=('gtk4' 'libadwaita' 'mpv' 'wayland' 'ffmpegthumbnailer' 'glib2')
optdepends=(
  'intel-media-driver: VA-API hardware decode on Intel GPUs'
  'gst-plugins-good: hover-to-play previews in the library'
  'gst-libav: hover-to-play previews in the library'
  'pipewire: system-audio capture for the audio visualiser widget (pw-cat)'
  'libpulse: system-audio capture fallback for the audio visualiser (parec)'
  'ffmpeg: rotated thumbnails and library media metadata (ffprobe)'
  'xdg-utils: opening help and tutorial links in your browser'
  # Lock-screen aesthetics (docs/plan-lock-screen.md): each host's own locker,
  # needed by exactly one of them, so none of these are hard dependencies.
  'xsecurelock: X11 lock screen with the live wallpaper and widgets (fresco lock)'
  'swaylock-plugin: wlroots lock screen with the live wallpaper and widgets (fresco lock)'
  'qt6-multimedia: video playback in the KDE Plasma desktop and lock-screen wallpaper'
)
source=("$url/releases/download/v$pkgver/fresco_${pkgver}-1_amd64.deb")
sha256sums=('SKIP')  # pin per release: curl -L <asset-url> | sha256sum
noextract=("fresco_${pkgver}-1_amd64.deb")

package() {
  # A .deb is an ar archive: control.tar.* + data.tar.*; we only need data.
  cd "$srcdir"
  ar x "fresco_${pkgver}-1_amd64.deb" data.tar.xz 2>/dev/null \
    || ar x "fresco_${pkgver}-1_amd64.deb" data.tar.zst
  if [ -f data.tar.xz ]; then
    tar -xJf data.tar.xz -C "$pkgdir"
  else
    tar --zstd -xf data.tar.zst -C "$pkgdir"
  fi
  # The .deb already ships the hicolor fixed-size PNG icons (48–512px) plus the
  # scalable SVG, so extracting data.tar above installs them — nothing extra.
  # Same for the lock-screen aesthetics files (usr/lib/fresco/saver_fresco,
  # usr/share/applications/screensavers/fresco.desktop, and the KDE Plasma
  # wallpaper plugin under usr/share/plasma/wallpapers/ and usr/share/fresco/) —
  # see Cargo.toml's [package.metadata.deb] assets, which data.tar mirrors.
  # Debian's libmpv soname differs from Arch's; the app dlopens libmpv.so.2
  # then .so.1 then .so, and Arch's mpv package provides libmpv.so.2 — fine.
  install -Dm644 "$pkgdir/usr/share/doc/fresco/copyright" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
